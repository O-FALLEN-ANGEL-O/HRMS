{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hr-plus",
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by OpenNext; must match "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hr-plus"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hr-plus",
			// Replace with the id printed by `npx wrangler d1 create hr-plus` (see DEPLOY.md).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"DEMO_MODE": "true"
	},
	"triggers": {
		// 02:00 IST every day: reset the demo data.
		"crons": ["30 20 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
